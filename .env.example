# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# AI
OPENAI_API_KEY=sk-...                 # embeddings + gpt-4o-mini answers
OPENROUTER_API_KEY=                   # optional: DeepSeek Chat model
DEEPSEEK_MODEL=deepseek/deepseek-chat

# Paddle Billing — use sandbox values for testing, live values in production
PADDLE_ENVIRONMENT=sandbox            # sandbox | production (server API)
NEXT_PUBLIC_PADDLE_ENV=sandbox        # sandbox | production (Paddle.js)
PADDLE_API_KEY=                       # server API key (billing portal)
PADDLE_WEBHOOK_SECRET=                # notification destination secret key
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=      # client-side token
NEXT_PUBLIC_PADDLE_PRICE_STARTER=pri_...
NEXT_PUBLIC_PADDLE_PRICE_GROWTH=pri_...
NEXT_PUBLIC_PADDLE_PRICE_AGENCY=pri_...

# Google Analytics 4 (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Public site URL (used for metadata)
NEXT_PUBLIC_APP_URL=https://your-domain.com
